{
  "name": "administracion-empanadas-angela",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12 <23" },
  "scripts": {
    "dev": "concurrently -n api,web -c '#9B6A4E,#D98B62' \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "npm run db:generate && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "5.90.21",
    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "express-rate-limit": "8.6.1",
    "helmet": "8.1.0",
    "lucide-react": "0.563.0",
    "prisma": "6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.71.1",
    "react-router-dom": "7.18.2",
    "recharts": "3.7.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.10.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "5.1.4",
    "concurrently": "9.2.1",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "jsdom": "27.4.0",
    "supertest": "7.2.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vite": "7.2.4",
    "vitest": "4.0.18"
  }
}
