generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COLLABORATOR
}

enum ExpenseStatus {
  REGISTERED
  VERIFIED
  VOIDED
}

enum IncomeStatus {
  ACTIVE
  VOIDED
}

enum PayableStatus {
  PENDING
  PAID
  VOIDED
}

enum PayrollStatus {
  PENDING
  PAID
  VOIDED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Frequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM
}

enum EventStatus {
  PENDING
  COMPLETED
  VOIDED
}

model User {
  id        Int        @id @default(autoincrement())
  username  String     @unique @db.VarChar(40)
  name      String     @db.VarChar(100)
  pinHash   String     @db.VarChar(255)
  role      Role
  active    Boolean    @default(true)
  sessions  Session[]
  expenses  Expense[]  @relation("ExpenseCreator")
  incomes   Income[]   @relation("IncomeCreator")
  auditLogs AuditLog[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([role, active])
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @db.Char(64)
  csrfToken String   @db.VarChar(96)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id        Int      @id @default(autoincrement())
  username  String   @db.VarChar(40)
  ipHash    String   @db.Char(64)
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([username, ipHash, createdAt])
}

model Category {
  id        Int                    @id @default(autoincrement())
  name      String                 @unique @db.VarChar(100)
  active    Boolean                @default(true)
  sortOrder Int                    @default(0)
  expenses  Expense[]
  payables  Payable[]
  rules     RecurringPaymentRule[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([active, sortOrder])
}

model PaymentMethod {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(60)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Expense {
  id             Int             @id @default(autoincrement())
  description    String          @db.VarChar(180)
  categoryId     Int
  category       Category        @relation(fields: [categoryId], references: [id])
  otherDetail    String?         @db.VarChar(120)
  quantity       Decimal         @db.Decimal(12, 3)
  unit           String          @db.VarChar(30)
  unitValue      Decimal         @db.Decimal(14, 2)
  total          Decimal         @db.Decimal(14, 2)
  paymentMethod  String          @db.VarChar(60)
  supplier       String?         @db.VarChar(140)
  note           String?         @db.VarChar(500)
  status         ExpenseStatus   @default(REGISTERED)
  createdById    Int
  createdBy      User            @relation("ExpenseCreator", fields: [createdById], references: [id])
  idempotencyKey String          @unique @db.VarChar(100)
  payableId      Int?            @unique
  payable        Payable?        @relation(fields: [payableId], references: [id])
  payrollId      Int?            @unique
  payroll        PayrollPayment? @relation(fields: [payrollId], references: [id])
  occurredAt     DateTime        @default(now())
  voidedAt       DateTime?
  voidReason     String?         @db.VarChar(300)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([occurredAt])
  @@index([categoryId, status])
  @@index([createdById, occurredAt])
}

model Income {
  id            Int          @id @default(autoincrement())
  concept       String       @db.VarChar(180)
  type          String       @db.VarChar(50)
  units         Decimal?     @db.Decimal(12, 3)
  total         Decimal      @db.Decimal(14, 2)
  paymentMethod String       @db.VarChar(60)
  channel       String       @db.VarChar(60)
  note          String?      @db.VarChar(500)
  status        IncomeStatus @default(ACTIVE)
  createdById   Int
  createdBy     User         @relation("IncomeCreator", fields: [createdById], references: [id])
  occurredAt    DateTime
  voidedAt      DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([occurredAt, status])
}

model Payable {
  id            Int           @id @default(autoincrement())
  name          String        @db.VarChar(180)
  beneficiary   String        @db.VarChar(140)
  categoryId    Int
  category      Category      @relation(fields: [categoryId], references: [id])
  amount        Decimal       @db.Decimal(14, 2)
  dueDate       DateTime
  priority      Priority      @default(MEDIUM)
  status        PayableStatus @default(PENDING)
  paymentMethod String?       @db.VarChar(60)
  paidAt        DateTime?
  note          String?       @db.VarChar(500)
  expense       Expense?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([dueDate, status])
  @@index([categoryId])
}

model RecurringPaymentRule {
  id             Int                 @id @default(autoincrement())
  name           String              @db.VarChar(180)
  beneficiary    String              @db.VarChar(140)
  categoryId     Int
  category       Category            @relation(fields: [categoryId], references: [id])
  estimatedValue Decimal             @db.Decimal(14, 2)
  frequency      Frequency
  intervalDays   Int?
  startDate      DateTime
  endDate        DateTime?
  nextDueDate    DateTime
  reminderDays   Int                 @default(3)
  active         Boolean             @default(true)
  occurrences    PaymentOccurrence[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([active, nextDueDate])
}

model PaymentOccurrence {
  id        Int                  @id @default(autoincrement())
  ruleId    Int
  rule      RecurringPaymentRule @relation(fields: [ruleId], references: [id])
  dueDate   DateTime
  amount    Decimal              @db.Decimal(14, 2)
  status    PayableStatus        @default(PENDING)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([ruleId, dueDate])
  @@index([dueDate, status])
}

model Employee {
  id           Int              @id @default(autoincrement())
  name         String           @db.VarChar(120)
  document     String?          @db.VarChar(40)
  position     String           @db.VarChar(100)
  active       Boolean          @default(true)
  usualPayment Decimal          @db.Decimal(14, 2)
  payroll      PayrollPayment[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([active])
}

model PayrollPayment {
  id            Int           @id @default(autoincrement())
  employeeId    Int
  employee      Employee      @relation(fields: [employeeId], references: [id])
  periodFrom    DateTime
  periodTo      DateTime
  basePayment   Decimal       @db.Decimal(14, 2)
  extras        Decimal       @default(0) @db.Decimal(14, 2)
  bonuses       Decimal       @default(0) @db.Decimal(14, 2)
  deductions    Decimal       @default(0) @db.Decimal(14, 2)
  total         Decimal       @db.Decimal(14, 2)
  dueDate       DateTime
  paidAt        DateTime?
  paymentMethod String?       @db.VarChar(60)
  status        PayrollStatus @default(PENDING)
  notes         String?       @db.VarChar(500)
  expense       Expense?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([dueDate, status])
  @@index([employeeId])
}

model CalendarEvent {
  id          Int         @id @default(autoincrement())
  title       String      @db.VarChar(180)
  startsAt    DateTime
  description String?     @db.VarChar(500)
  type        String      @db.VarChar(50)
  status      EventStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([startsAt, status])
}

model BusinessSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(80)
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  action     String   @db.VarChar(80)
  entity     String   @db.VarChar(80)
  entityId   String   @db.VarChar(80)
  beforeData Json?
  afterData  Json?
  reason     String?  @db.VarChar(300)
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId])
}
